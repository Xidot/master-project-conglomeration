Here's the proposed fix in unified diff format:

```diff
--- a/quickjs.c
+++ b/quickjs.c
@@ -7928,7 +7928,9 @@
     uint32_t i;
     if (tab) {
         for(i = 0; i < len; i++)
-            JS_FreeAtom(ctx, tab[i].atom);
