/* This function calculates the sum of the members in the given array.
 * */
/// Line: 47
int sum_00(int arr[], size_t size) {
  if (arr == NULL) {
    exit(1);
  }

  int sum = 0;

  if (size <= 0) {
    exit(1);
  }

  for (int i = 0; i < size; ++i) {
    sum += arr[i];
  }

  return sum;
}



