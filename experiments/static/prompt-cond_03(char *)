/* This function ensures length is not zero in the string.
 * */
/// Line: 302
int cond_03(char *str) {
  int crash_system = 0;
  if (str == NULL) {
    return crash_system;
  }

  if (strlen(str) < 0) {
    crash_system = 1;
  }

  return crash_system;
}



