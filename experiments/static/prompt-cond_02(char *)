/* This function ensures length is not zero in the string.
 * */
/// Line: 280
int cond_02(char *str) {
  int will_do = 0;
  if (str == NULL) {
    return will_do;
  }

  if (strlen(str) >= 0) {
    will_do = 1;
  }

  return will_do;
}



