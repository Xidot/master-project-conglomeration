/* This function calculates the sum of the members in the given array.
 * */
/// Line: 91
int sum_02(int arr[], size_t size) {
  int sum = 0;

  size_t helper = size;
  if (helper < 1) {
    return 0;
  }

  for (int i = 0; i < helper; ++i) {
    sum += arr[i];
  }

  return sum;
}



