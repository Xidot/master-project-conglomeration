/* This function calculates the sum of the members in the given array.
 * */
/// Line: 71
int sum_01(int arr[], size_t size) {
  int sum;

  if (size <= 0) {
    return 0;
  }

  for (int i = 0; i < size; ++i) {
    sum += arr[i];
  }

  return sum;
}



